---
import Layout from './Layout.astro';
const { frontmatter } = Astro.props;
const { title, category, summary, role, period, team, tools, evidence, note } = frontmatter;
const base = import.meta.env.BASE_URL;
---
<Layout title={`${title} — Jeffrey Huang`} description={summary}>
  <div class="shell">
    <header class="detail-header"><a class="back-link" href={base}>← Back to all work</a><div class="eyebrow">{category}</div><h1>{title}</h1><p class="detail-summary">{summary}</p><div class="detail-meta"><span>{role}</span><span>{period}</span><span>{team}</span></div></header>
    <div class="article-layout">
      <aside class="article-aside"><h2>Tools & methods</h2><div class="tags">{tools.map((tool:string)=><span>{tool}</span>)}</div><h2 style="margin-top:30px">Project material</h2>{evidence?.map((item:{label:string,url:string})=><a href={item.url}>{item.label} ↗</a>)}{note && <p>{note}</p>}</aside>
      <article class="article-content"><slot /><div class="detail-footer"><a href={base}>← All work</a><a href="mailto:j.huang.hxc@gmail.com">Get in touch ↗</a></div></article>
    </div>
  </div>
</Layout>
